<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Isai" Manufacturer="Isai" Version="1.0.0"
           UpgradeCode="7B3E5C0A-4D2F-4E8B-9A61-2C5F8D1E6B47"
           Scope="perMachine" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Isai is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="IsaiIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="IsaiIcon" />
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />

    <Property Id="SHORTCUT_DESKTOP" Value="1" />
    <Property Id="SHORTCUT_START" Value="1" />

    <Property Id="WV2_MACHINE">
      <RegistrySearch Id="Wv2Machine" Root="HKLM" Bitness="always64"
        Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv" Type="raw" />
    </Property>
    <Property Id="WV2_USER">
      <RegistrySearch Id="Wv2User" Root="HKCU" Bitness="always64"
        Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Isai" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(DistDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="WebView2Files" Directory="INSTALLFOLDER">
      <Component Id="WebView2Bootstrapper">
        <File Id="WebView2Setup" Source="$(Wv2Setup)" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComp" Condition="SHORTCUT_START">
        <Shortcut Id="StartMenuShortcut" Name="Isai"
                  Target="[INSTALLFOLDER]Isai.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="IsaiIcon" />
        <RegistryValue Root="HKCU" Key="Software\Isai" Name="startmenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp" Condition="SHORTCUT_DESKTOP">
        <Shortcut Id="DesktopShortcut" Name="Isai"
                  Target="[INSTALLFOLDER]Isai.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="IsaiIcon" />
        <RegistryValue Root="HKCU" Key="Software\Isai" Name="desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Isai" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="WebView2Files" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <ComponentRef Id="DesktopShortcutComp" />
    </Feature>

    <CustomAction Id="InstallWebView2" FileRef="WebView2Setup"
                  ExeCommand="/silent /install"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="InstallWebView2" After="InstallFiles"
              Condition="NOT Installed AND NOT WV2_MACHINE AND NOT WV2_USER" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="Isai Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Choose shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="Select where Isai should be available." />
        <Control Id="DesktopCheck" Type="CheckBox" X="30" Y="80" Width="300" Height="18"
                 Property="SHORTCUT_DESKTOP" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="StartCheck" Type="CheckBox" X="30" Y="108" Width="300" Height="18"
                 Property="SHORTCUT_START" CheckBoxValue="1" Text="Add Isai to the &amp;Start Menu" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog"
               Value="WelcomeDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />
    </UI>
  </Package>
</Wix>
